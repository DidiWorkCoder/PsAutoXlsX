{
  "name": "psauto",
  "version": "1.0.0",
  "description": "批量图片文字生成器",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "author": "psauto",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "ant-design-vue": "^4.2.6",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.psauto.batch",
    "productName": "PsAuto",
    "disableAsarIntegrity": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PsAuto.exe"
    }
  }
}
